desktop/renderer/sprites/** filter=lfs diff=lfs merge=lfs -text
web/assets/sprites/** filter=lfs diff=lfs merge=lfs -text
web/public/pets/** filter=lfs diff=lfs merge=lfs -text
# Shell scripts run under /bin/sh on Linux and Mac. Keep them LF on every checkout,
# so a build made on Windows (core.autocrlf=true) does not ship CRLF probes.
*.sh text eol=lf
