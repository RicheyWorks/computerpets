# Copy to .env for local builds, or set these in the web host's project environment (Vercel).
# Nothing here is a secret. Never put an admin key or API key in a VITE_ variable: it ships to the browser.

# Where the /admin ledger's "License service" field starts: the ComputerPets license service's public
# address, e.g. the Java service's API_PUBLIC_BASE_URL. Unset: the page starts from its own origin,
# and only a page on localhost starts from http://localhost:8081. The field stays editable.
# The license service must allow this web site's origin: ADMIN_ALLOWED_ORIGINS (deploy/k8s/README.md).
VITE_LICENSE_API_URL=

# Set to "false" to hide the sign-in buttons (see src/lib/auth/client.ts).
# VITE_AUTH_ENABLED=false

# Public host name for social preview images (see src/routes/__root.tsx).
# VITE_PUBLIC_HOSTNAME=

# Grok sign-in. Deployed apps get these injected per app; leave blank locally unless you have them.
# The shared live-preview client secret is no longer stored in the repo.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PREVIEW_CLIENT_SECRET=
BETTER_AUTH_URL=
