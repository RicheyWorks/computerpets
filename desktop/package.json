{
  "name": "computerpets-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Living desk companions for Windows and Mac.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test license/*.test.cjs",
    "dist": "electron-builder --win --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "works.richey.computerpets.desk",
    "productName": "ComputerPets",
    "directories": { "output": "dist" },
    "files": [
      "main.cjs",
      "preload.cjs",
      "license/**/*.cjs",
      "!license/**/*.test.cjs",
      "!license/contract-test-double.cjs",
      "renderer/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "renderer/icon.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.entertainment",
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
