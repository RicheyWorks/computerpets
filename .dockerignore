# Build artifacts
target/
!target/*.jar

# IDE and OS files
.idea/
*.iml
*.swp
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# The backend image copies only pom.xml and src; client art and source-audio
# mailboxes are runtime inputs for the separate clients, not this build.
web/
desktop/
client/
cries-in/

# Documentation (not needed in image)
docs/
*.md
LICENSE
CONTRIBUTING.md
ROADMAP.md

# Test resources (not needed at runtime)
src/test/

# Docker itself
Dockerfile
docker-compose.yml
.dockerignore

# CI files
.github/

# Environment and secrets
.env
.env.*
*.env

# Maven wrapper (we'll use the Maven image or system mvn in CI)
mvnw
mvnw.cmd
.mvn/
