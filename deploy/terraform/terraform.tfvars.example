# Example tfvars — copy to terraform.tfvars (gitignored) for a real plan/apply.
# Do NOT put LICENSE_SECRET_KEY, JWT_SECRET_KEY, BUNDLE_SIGNING_KEY, or
# ADMIN_API_KEY here. Those stay in Secrets Manager / Vault for External Secrets.

project_name = "computerpets"
environment  = "prod"
aws_region   = "us-east-1"

# Required before Postgres/Redis resources are created:
# vpc_id             = "vpc-xxxxxxxx"
# private_subnet_ids = ["subnet-aaa", "subnet-bbb"]
# app_cidr_blocks    = ["10.0.0.0/16"]   # private app/pod CIDRs only

# Deny-safe — leave false:
postgres_publicly_accessible = false
write_house_secret_values    = false

enable_postgres = true
enable_redis    = true
enable_secrets  = true
enable_cdn      = true
enable_waf      = true

# Postgres transit TLS (ADR 0076) is on for every provisioned RDS instance
# (rds.force_ssl=1, jdbc sslmode=require). To switch the URL to verify-full,
# set postgres_ssl_root_cert only after you mount a real PEM. Leave it unset
# here. This file does not name a bundle.

# Redis AUTH (ADR 0075). Leave unset for the AUTH-less cache cluster.
# When you want AUTH + transit TLS, export TF_VAR_redis_auth_token
# (openssl rand -hex 16). Do not write the token in this file.
# The app then needs REDIS_PASSWORD, REDIS_SSL=true, REDIS_AUTH_REQUIRED=true.

# Required for plan/apply while enable_waf is true (ADR 0074).
# Empty is validate-only. Use the API application load balancer, not an NLB
# and not the bundle CloudFront distribution.
# waf_associate_alb_arn = "arn:aws:elasticloadbalancing:us-east-1:000000000000:loadbalancer/app/computerpets/example"
